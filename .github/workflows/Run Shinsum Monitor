- name: Run Shinsum Monitor
        env:
          SHINSUM_USER: ${{ secrets.SHINSUM_USER }}
          SHINSUM_PASS: ${{ secrets.SHINSUM_PASS }}
          MONITOR_DISCORD_WEBHOOK_URL: ${{ secrets.MONITOR_DISCORD_WEBHOOK_URL }}
        run: python monitor.py

      - name: Run Result Checker
        env:
          RESULT_DISCORD_WEBHOOK_URL: ${{ secrets.RESULT_DISCORD_WEBHOOK_URL }}
        run: python result_checker.py
